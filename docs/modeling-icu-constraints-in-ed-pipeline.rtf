# Cell \'933A\'94 \'97 ICU mapping + label functions\uc0\u8232 # ICU preference by condition (simple, editable)\u8232 ICU_PREFS = \{\u8232     "cardiac": ["cap_cardio_icu", "cap_cardio_surgery_icu", "cap_vascular_cardiac_icu"],\u8232     "respiratory": ["cap_internal_medicine_icu", "cap_interdis_stage1", "cap_interdis_stage2", "cap_interdis_stage3"],\u8232     "neurological": ["cap_neurological_icu", "cap_neurochirurgical_icu", "cap_interdis_stage1"],\u8232     "infection": ["cap_internal_medicine_icu", "cap_interdis_stage2"],\u8232     "trauma": ["cap_surgical_icu", "cap_interdis_stage3"],\u8232     "oncology": ["cap_internal_medicine_icu", "cap_interdis_stage2"],\u8232     "gastrointestinal": ["cap_surgical_icu", "cap_internal_medicine_icu"]\u8232 \}\u8232 \u8232 def best_relevant_icu_capacity(rec: dict) -> float:\u8232     """Return the max normalized capacity across relevant ICUs for this condition."""\u8232     cond = rec["suspected_condition"]\u8232     keys = ICU_PREFS.get(cond, [])\u8232     if not keys:\u8232         return 0.0\u8232     vals = [float(rec.get(k, 0.0)) for k in keys]\u8232     return max(vals) if vals else 0.0\u8232 \u8232 def synth_icu_labels(rec: dict) -> dict:\u8232     """\u8232     Make labels depend on ICU capacity + acuity.\u8232     - icu_assignment_suitability: higher if relevant ICU has capacity.\u8232     - icu_bottleneck_risk: high when relevant ICU is near zero.\u8232     - pathway_latency_min: inflates when bottleneck risk is high (ED boarding).\u8232     - route_plan: EMS
