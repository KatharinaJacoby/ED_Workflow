2     non_icu_sizes = \{\u8232         'internal_medicine': 50, 'neurology': 50, 'surgery_general': 50,\u8232         'cardiology': 30, 'pulmonology': 30, 'gastroenterology': 30,\u8232         'orthopedics': 30, 'surgery_trauma': 30, 'vascular_surgery': 30,\u8232         'oncology': 20, 'pediatrics': 20, 'obstetrics_gynecology': 20,\u8232         'psychiatry': 20, 'palliative': 20, 'imc_internal_medicine': 20\u8232     \}\u8232     non_icu_caps = \{f"cap_\{k\}": round(np.random.randint(0, int(beds*0.5) + 1) / beds, 2)\u8232                     for k, beds in non_icu_sizes.items()\}\u8232 \u8232     # Assemble record\u8232     record = \{\u8232         "patient_id": patient_id,\u8232         "age": age,\u8232         "home_type": home_type,\u8232         "suspected_condition": suspected_condition,\u8232         "ems_start_time": ems_start_time,\u8232         "ems_triage_code": int(ems_triage_code),\u8232         "ems_target_hospital": ems_target_hospital,\u8232         "ed_arrival_time": ed_arrival_time,\u8232         "day_of_week": day_of_week,\u8232         "hour_of_day": hour_of_day,\u8232         **icu_caps,\u8232         **non_icu_caps,\u8232     \}\u8232 \u8232     # ICU-driven labels\u8232     record.update(synth_icu_labels(record))\u8232     return record\u8232 \u8232 \u8232 \
