\f0  Patient generator using real ICU and simulated non-ICU capacities\uc0\u8232 \u8232 import uuid\u8232 import pandas as pd\u8232 import numpy as np\u8232 from datetime import datetime, timedelta\u8232 \u8232 # Fixed suspected conditions for now\u8232 SUSPECTED_CONDITIONS = [\u8232     "cardiac", "respiratory", "neurological",\u8232     "gastrointestinal", "oncology", "infection", "trauma"\u8232 ]\u8232 \u8232 HOME_TYPES = ["private", "nursing_home"]\u8232 \u8232 def generate_patient():\u8232     # Static patient attributes\u8232     patient_id = str(uuid.uuid4())[:8]\u8232     age = np.random.randint(18, 95)\u8232     home_type = np.random.choice(HOME_TYPES)\u8232     suspected_condition = np.random.choice(SUSPECTED_CONDITIONS)\u8232     \u8232     # EMS and ED timing\u8232     ems_start_time = datetime(2025, 8, 7) + timedelta(\u8232         hours=np.random.randint(0, 24),\u8232         minutes=np.random.randint(0, 60)\u8232     )\u8232     ems_triage_code = np.random.randint(1, 5)  # 1=most urgent, 4=least\u8232     ems_target_hospital = "UKE"\u8232     ed_arrival_time = ems_start_time + timedelta(minutes=np.random.randint(5, 30))\u8232 \u8232     # Capacity snapshot for all departments (normalized)\u8232     capacities = capacity_snapshot_normalized()\u8232 \u8232     # Target: for now, simple suitability score for ward assignment\u8232     ward_assignment_suitability = np.random.uniform(0, 1)\u8232 \u8232     # Combine all fields\u8232     record = \{\u8232         "patient_id": patient_id,\u8232         "age": age,\u8232         "home_type": home_type,\u8232         "suspected_condition": suspected_condition,\u8232         "ems_start_time": ems_start_time,\u8232         "ems_triage_code": ems_triage_code,\u8232         "ems_target_hospital": ems_target_hospital,\u8232         "ed_arrival_time": ed_arrival_time,\u8232     \}\u8232 \u8232     # Add department capacities as features\u8232     for dept, cap in capacities.items():\u8232         record[f"cap_\{dept\}"] = cap\u8232 \u8232     # Output target(s)\u8232     record["ward_assignment_suitability"] = ward_assignment_suitability\u8232 \u8232     return record\u8232 \u8232 def generate_dataset(n_patients=500):\u8232     patients = [generate_patient() for _ in range(n_patients)]\u8232     return pd.DataFrame(patients)\u8232 \u8232 # Quick test\u8232 df = generate_dataset(5)\u8232 print(df.head())\u8232 print("\\nShape:", df.shape)\
