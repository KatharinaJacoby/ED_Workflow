\f1 1\uc0\u65039 \u8419 
\f0  Hospital & department capacity setup (derived from UKE)\uc0\u8232 \u8232 import random\u8232 \u8232 # --- ICU units (real counts) -----------------------------------------------\u8232 # Each ICU must reserve 1 bed for resuscitation => operational_beds = total_beds - 1\u8232 ICU_TOTAL_BEDS = \{\u8232     "neurochirurgical_icu": 12,\u8232     "neurological_icu": 12,\u8232     "interdis_stage1": 12,     # UKE 1C\u8232     "interdis_stage2": 12,     # UKE 1D\u8232     "interdis_stage3": 12,     # UKE 1E\u8232     "surgical_icu": 12,        # UKE 1F\u8232     "internal_medicine_icu": 12,  # UKE 1G\u8232     "cardio_icu": 12,          # UKE H1b (cardiology)\u8232     "cardio_surgery_icu": 12,  # UKE H1b (cardiac surgery)\u8232     "vascular_cardiac_icu": 8  # UKE H2b\u8232 \}\u8232 \u8232 ICU_OPERATIONAL_BEDS = \{\u8232     k: max(v - 1, 0) for k, v in ICU_TOTAL_BEDS.items()\u8232 \}\u8232 \u8232 # --- Non-ICU departments (simulated sizes) ----------------------------------\u8232 # Rule of thumb: Large=50, Medium=30, Small=20\u8232 DEPARTMENTS_SIZE = \{\u8232     # Large\u8232     "internal_medicine": 50,\u8232     "neurology": 50,\u8232     "surgery_general": 50,\u8232 \u8232     # Medium\u8232     "cardiology": 30,\u8232     "pulmonology": 30,\u8232     "gastroenterology": 30,\u8232     "orthopedics": 30,\u8232     "surgery_trauma": 30,\u8232     "vascular_surgery": 30,\u8232 \u8232     # Small\u8232     "oncology": 20,\u8232     "pediatrics": 20,\u8232     "obstetrics_gynecology": 20,\u8232     "psychiatry": 20,\u8232     "palliative": 20,\u8232     "imc_internal_medicine": 20,\u8232 \}\u8232 \u8232 # Combine into a single capacity registry (operational bed counts)\u8232 OPER_BEDS = \{\u8232     **ICU_OPERATIONAL_BEDS,\u8232     **DEPARTMENTS_SIZE\u8232 \}\u8232 \u8232 # --- Availability sampling ---------------------------------------------------\u8232 # Availability is sampled per patient/event: 0%..50% free, with a small chance of 0% hard block\u8232 def sample_availability_fraction(hard_block_prob: float = 0.10) -> float:\u8232     """Return a fraction of free capacity in [0.0, 0.5]. Sometimes forced to 0.0."""\u8232     if random.random() < hard_block_prob:\u8232         return 0.0\u8232     return random.uniform(0.0, 0.5)\u8232 \u8232 def capacity_snapshot_normalized(hard_block_prob: float = 0.10) -> dict:\u8232     """\u8232     Produce a dict of normalized capacity scores per department (0..1),\u8232     computed as available_beds / operational_beds for the current moment.\u8232     """\u8232     snap = \{\}\u8232     for dept, oper_beds in OPER_BEDS.items():\u8232         if oper_beds <= 0:\u8232             snap[dept] = 0.0\u8232             continue\u8232         frac = sample_availability_fraction(hard_block_prob)\u8232         available = int(round(oper_beds * frac))\u8232         snap[dept] = available / oper_beds\u8232     return snap\u8232 \u8232 # Convenience lists if needed later\u8232 ICU_DEPARTMENTS = list(ICU_OPERATIONAL_BEDS.keys())\u8232 NON_ICU_DEPARTMENTS = list(DEPARTMENTS_SIZE.keys())\u8232 ALL_DEPARTMENTS = list(OPER_BEDS.keys())\u8232 \u8232 # Sanity print (optional)\u8232 print("ICU operational beds:", ICU_OPERATIONAL_BEDS)\u8232 print("Non-ICU sizes:", DEPARTMENTS_SIZE)\
ICU operational beds: \{'neurochirurgical_icu': 11, 'neurological_icu': 11, 'interdis_stage1': 11, 'interdis_stage2': 11, 'interdis_stage3': 11, 'surgical_icu': 11, 'internal_medicine_icu': 11, 'cardio_icu': 11, 'cardio_surgery_icu': 11, 'vascular_cardiac_icu': 7\}\uc0\u8232 Non-ICU sizes: \{'internal_medicine': 50, 'neurology': 50, 'surgery_general': 50, 'cardiology': 30, 'pulmonology': 30, 'gastroenterology': 30, 'orthopedics': 30, 'surgery_trauma': 30, 'vascular_surgery': 30, 'oncology': 20, 'pediatrics': 20, 'obstetrics_gynecology': 20, 'psychiatry': 20, 'palliative': 20, 'imc_internal_medicine': 20\}\
